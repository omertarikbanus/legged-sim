    <pair geom1="slope40_geom" geom2="ROBOT_FOOT_4" condim="3" friction="10 10 10"
      solimp="0.9 0.95 0.001 0.1 6" /> -->


  </contact>
  <sensor>
    <accelerometer name="acc" site="sensorsurf" />
    <gyro site="sensorsurf" />
    <framequat name="quat" objtype="body" objname="demir/base_link_inertia" />
  </sensor>

  <keyframe>
    <key name="home" qpos="-1 -1 -1.27 1 0 0  0
     0.1 0.9 -1.8
      0.1 0.9 -1.8 
      0.1 0.9 -1.8 
      0.3 0.9 -1.8"
      />
  </keyframe>
</mujoco>