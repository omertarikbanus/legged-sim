<mujoco model="demir_1">
  <include file="robot.xml" />
  <compiler angle="radian" autolimits="true" meshdir="./meshes" />
  <statistic meansize="0.233652" extent="1.00882" center="0 0 -0.175588" />
  <asset>
    <!-- <hfield name="hmap" file="my_output_image.png" size="3 3 0.3 0.07"/> -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="32"
      height="192" />
    <texture type="cube" name="body" builtin="flat" mark="cross" rgb1="0.8 0.6 0.4"
      rgb2="0.8 0.6 0.4" markrgb="1 1 1" width="127" height="762" />
    <texture type="2d" name="grid" builtin="checker" rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4"
      width="512" height="512" />
    <material name="body" texture="body" texuniform="true" rgba="0.8 0.6 0.4 1" />
    <material name="grid" texture="grid" texuniform="true" reflectance="0.2" />
    <!-- <mesh name="slope" file="slope.stl" scale="1 1 1" /> -->
  </asset>
  <worldbody>
    <geom name="floor" size="0 0 1" type="plane" material="grid" />

    <light name="spotlight" target="demir/base_link_inertia" pos="0 -6 6" dir="0 0 -1" cutoff="30"
      diffuse="0.8 0.8 0.8" mode="targetbodycom" />


    <!-- <body name="slope40" pos="-3 1 0">
      <geom name="slope40_geom" type="box" size="2 4 0.1" pos="0 0 0"
        quat="0.9397 0.3420 0 0" rgba="0.8 0.3 0.3 1" />
    </body> -->


    <!-- <body pos="1. 1 0" euler="0 0 1.57">
      <inertial pos="0.5 .5 0" mass="18" />
      <geom type="mesh" mesh="slope" name="slope" rgba=".9 0 0 0.1" />
    </body> -->

  </worldbody>
  <actuator>
    <motor name="demir/abad_1_torque" joint="demir/abad_1_joint" forcelimited="true"
      forcerange="-125 125" />
    <motor name="demir/hip_1_joint" joint="demir/hip_1_joint" forcelimited="true"
      forcerange="-125 125" />



    <motor name="demir/knee_1_joint" joint="demir/knee_1_joint" forcelimited="true"
      forcerange="-125 125" />
   


    <motor name="demir/abad_2_torque" joint="demir/abad_2_joint" forcelimited="true"
      forcerange="-125 125" />
   
    <motor name="demir/hip_2_joint" joint="demir/hip_2_joint" forcelimited="true"
      forcerange="-125 125" />



    <motor name="demir/knee_2_joint" joint="demir/knee_2_joint" forcelimited="true"
      forcerange="-125 125" />
 


    <motor name="demir/abad_3_torque" joint="demir/abad_3_joint" forcelimited="true"
      forcerange="-125 125" />


    <motor name="demir/hip_3_joint" joint="demir/hip_3_joint" forcelimited="true"
      forcerange="-125 125" />
   


    <motor name="demir/knee_3_joint" joint="demir/knee_3_joint" forcelimited="true"
      forcerange="-125 125" />
    

    <motor name="demir/abad_4_torque" joint="demir/abad_4_joint" forcelimited="true"
      forcerange="-125 125" />
  

    <motor name="demir/hip_4_joint" joint="demir/hip_4_joint" forcelimited="true"
      forcerange="-125 125" />



    <motor name="demir/knee_4_joint" joint="demir/knee_4_joint" forcelimited="true"
      forcerange="-125 125" />



  </actuator>

  <contact>
    <pair geom1="floor" geom2="ROBOT_FOOT_1" condim="3" friction="1 1 0.005 0.0001 0.0001"
      solimp="0.9 0.95 0.001 0.1 6" />
    <pair geom1="floor" geom2="ROBOT_FOOT_2" condim="3" friction="1 1 0.005 0.0001 0.0001"
      solimp="0.9 0.95 0.001 0.1 6" />
    <pair geom1="floor" geom2="ROBOT_FOOT_3" condim="3" friction="1 1 0.005 0.0001 0.0001"
      solimp="0.9 0.95 0.001 0.1 6" />
    <pair geom1="floor" geom2="ROBOT_FOOT_4" condim="3" friction="1 1 0.005 0.0001 0.0001"
      solimp="0.9 0.95 0.001 0.1 6" />

    <exclude body1="demir/hip_1" body2="demir/base_link_inertia" />
    <exclude body1="demir/hip_2" body2="demir/base_link_inertia" />
    <exclude body1="demir/hip_3" body2="demir/base_link_inertia" />
    <exclude body1="demir/hip_4" body2="demir/base_link_inertia" />

    <exclude body1="demir/knee_1" body2="demir/base_link_inertia" />
    <exclude body1="demir/knee_2" body2="demir/base_link_inertia" />
    <exclude body1="demir/knee_3" body2="demir/base_link_inertia" />
    <exclude body1="demir/knee_4" body2="demir/base_link_inertia" />

